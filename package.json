{
  "name": "myst-docs",
  "version": "0.1.0",
  "description": "Section-level access to deployed MyST sites for humans and LLMs",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/responsible-genai-hackweek/MySTifAI.git"
  },
  "keywords": [
    "myst",
    "jupyter-book",
    "documentation",
    "cli",
    "llm",
    "agents"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "myst-docs": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "docs": "cd docs && myst build --html",
    "docs:live": "cd docs && myst start"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "mystmd": "^1.10.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@myst-theme/search": "^1.3.1",
    "@myst-theme/search-minisearch": "^1.3.1",
    "commander": "^14.0.3",
    "myst-spec-ext": "^1.10.0",
    "myst-to-md": "^1.0.16",
    "unified": "^11.0.5",
    "unist-util-select": "^5.1.0",
    "vfile": "^6.0.3"
  }
}
